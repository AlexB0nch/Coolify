# Переменные окружения воркера. Скопировать рядом без .example, вписать
# боевые значения и скормить скрипту:
#
#   ENV_FILE=./dd-cheki.env bash scripts/05-deploy-worker.sh
#
# Файл с реальными значениями в репозиторий не коммитить — .gitignore это
# уже запрещает, но проверь перед git add.

# Входящий вебхук Битрикс24, единственный секрет здесь
BITRIX_WEBHOOK=https://портал.bitrix24.ru/rest/1/ТОКЕН/

# Папки на Битрикс.Диске: входящая, разобранное, брак
DISK_FOLDER_IN=<id>
DISK_FOLDER_OK=<id>
DISK_FOLDER_BAD=<id>

# Период опроса, секунды
INTERVAL_SEC=600

# Уведомления в Telegram, необязательно
TG_BOT_TOKEN=
TG_CHAT_ID=

# 1 — только читать и писать в лог, ничего не менять в Битриксе.
# Первый запуск делать с 1, потом поставить 0 и нажать Redeploy.
DRY_RUN=1
